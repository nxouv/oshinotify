{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OshiNotify",
  "version": "1.0.0",
  "identifier": "com.oshi-notify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OshiNotify",
        "width": 900,
        "height": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "なな太郎",
    "shortDescription": "推しの配信を見逃さない通知アプリ",
    "copyright": "© 2025 nxouv",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"],
        "displayLanguageSelector": false
      }
    }
  }
}
